TELEGRAM_BOT_TOKEN=

# https URL for inline «Открыть Happ» (nginx /happ/ → connect_bot:8091/open)
# If empty: https://panel.alexsurfervpn.space/happ/open
# HAPP_REDIRECT_PUBLIC_URL=https://panel.alexsurfervpn.space/happ/open

# Default vless:// for «Открыть Happ» if user did not paste key in chat
# HAPP_DEFAULT_VLESS=vless://uuid@host:443?type=tcp#name

# Optional; default :8091 inside container
# HAPP_REDIRECT_LISTEN=:8091

# «Скачать Happ» → App Store
# HAPP_IOS_APP_STORE_URL=https://apps.apple.com/ru/app/happ-proxy-utility-plus/id6746188973
